# All variables are optional. The defaults use free, key-less public services
# that are rate limited and intended for light/demo traffic.

# Self-hosted or commercial OSRM-compatible routing endpoint
# VITE_OSRM_BASE_URL=https://router.project-osrm.org

# Self-hosted Photon geocoder endpoint
# VITE_PHOTON_BASE_URL=https://photon.komoot.io

# Cloud sign-in is NOT implemented in this build. These variables only change
# the message on the login screen; they do not enable authentication.
# VITE_AUTH_ISSUER=
# VITE_AUTH_CLIENT_ID=
